DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=gradsync
POSTGRES_USER=gradsync
POSTGRES_PASSWORD=gradsync
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://gradsync:gradsync@db:5432/gradsync
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@gradsync.local
EMAIL_SUBJECT_PREFIX=[GradSync]
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_TOKEN_SECONDS=300
JWT_REFRESH_TOKEN_SECONDS=604800
JWT_REFRESH_COOKIE_SAMESITE=Strict
GRADSYNC_UPLOAD_MAX_BYTES=104857600
EMAIL_VERIFICATION_CODE_TTL_MINUTES=30
ROLE_ACTIVATION_TTL_DAYS=14
# Account security and governance
GRADSYNC_RECOVERY_TOKEN_TTL_SECONDS=1800
GRADSYNC_EMAIL_CHANGE_TOKEN_TTL_SECONDS=1800
GRADSYNC_RECOVERY_THROTTLE_RATE=5/hour
GRADSYNC_EMAIL_SECURITY_THROTTLE_RATE=10/hour
GRADSYNC_SESSION_REVOCATION_THROTTLE_RATE=30/hour
GRADSYNC_APPROVED_FRONTEND_ORIGIN=http://localhost:5173
GRADSYNC_SESSION_ACTIVITY_UPDATE_SECONDS=300
GRADSYNC_AUDIT_RETENTION_DAYS=365
GRADSYNC_AUDIT_EXPORT_MAX_ROWS=10000
GRADSYNC_AUDIT_EXPORT_TTL_SECONDS=86400
# Research execution loop
GRADSYNC_NOTIFICATION_REMINDER_LEAD_MINUTES=1440
GRADSYNC_NOTIFICATION_ESCALATION_DELAY_MINUTES=1440
GRADSYNC_NOTIFICATION_REPEAT_INTERVAL_MINUTES=1440
GRADSYNC_NOTIFICATION_MAX_REMINDERS=3
GRADSYNC_NOTIFICATION_THRESHOLD_MIN_MINUTES=60
GRADSYNC_NOTIFICATION_THRESHOLD_MAX_MINUTES=10080
GRADSYNC_REPORT_ANALYTICS_MAX_PERIODS=104
GRADSYNC_REPORT_ANALYTICS_CACHE_SECONDS=60
GRADSYNC_EXECUTION_JOB_BATCH_SIZE=200
