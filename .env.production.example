DJANGO_SETTINGS_MODULE=gradsync.settings.production
DJANGO_SECRET_KEY=replace-with-a-64-character-random-secret
DJANGO_ALLOWED_HOSTS=gradsync.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://gradsync.example.edu
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
FRONTEND_ORIGIN=https://gradsync.example.edu
PUBLIC_API_BASE_URL=https://gradsync.example.edu/api
PUBLIC_BASE_URL=https://gradsync.example.edu
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/gradsync.example.edu/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/gradsync.example.edu/privkey.pem

POSTGRES_DB=gradsync
POSTGRES_USER=gradsync
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
GRADSYNC_POSTGRES_MAX_CONNECTIONS=40
GRADSYNC_POSTGRES_SHARED_BUFFERS=64MB
GRADSYNC_POSTGRES_WORK_MEM=2MB
GRADSYNC_POSTGRES_MAINTENANCE_WORK_MEM=32MB
POSTGRES_BACKUP_RETENTION_DAYS=14
POSTGRES_BACKUP_OFFSITE_URI=s3://gradsync-prod-backups/postgres/
BACKUP_RESTORE_DRILL_EVIDENCE=docs/ops/restore-drills/latest.md
GRADSYNC_POSTGRES_VOLUME_NAME=gradsync-production-postgres-data
GRADSYNC_POSTGRES_BACKUP_VOLUME_NAME=gradsync-production-postgres-backups
GRADSYNC_MEDIA_VOLUME_NAME=gradsync-production-media
GRADSYNC_REDIS_VOLUME_NAME=gradsync-production-redis
MEDIA_BACKUP_RETENTION_DAYS=14

REDIS_URL=redis://redis:6379/0
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_NOTIFICATION_QUEUE=notifications
CELERY_WORKER_PREFETCH_MULTIPLIER=1
GRADSYNC_CELERY_CONCURRENCY=1

GRADSYNC_GUNICORN_WORKERS=1
GRADSYNC_GUNICORN_THREADS=2
GRADSYNC_MIGRATE_MEM_LIMIT=256m
GRADSYNC_BACKEND_MEM_LIMIT=256m
GRADSYNC_FRONTEND_MEM_LIMIT=96m
GRADSYNC_WORKER_MEM_LIMIT=256m
GRADSYNC_SCHEDULER_MEM_LIMIT=160m
GRADSYNC_DB_MEM_LIMIT=384m
GRADSYNC_REDIS_MEM_LIMIT=128m

EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@gradsync.example.edu
EMAIL_SUBJECT_PREFIX=[GradSync]
EMAIL_PROVIDER=replace-with-provider-name
EMAIL_PROVIDER_DOMAIN=gradsync.example.edu
EMAIL_PROVIDER_REGION=replace-with-provider-region
EMAIL_DKIM_SELECTOR=replace-with-dkim-selector
EMAIL_BOUNCE_WEBHOOK_SECRET=replace-with-bounce-webhook-secret
PRODUCTION_SMTP_PROBE_TO=ops@example.edu

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
ALERT_WEBHOOK_URL=replace-with-alert-webhook-url
ALERT_ONCALL_TARGET=replace-with-oncall-target

REGISTRY_HOST=ghcr.io
REGISTRY_IMAGE_PREFIX=ghcr.io/example/gradsync
BACKEND_IMAGE=ghcr.io/example/gradsync/backend:replace-with-release-sha
FRONTEND_IMAGE=ghcr.io/example/gradsync/frontend:replace-with-release-sha
DEPLOY_HOST=replace-with-production-host
DEPLOY_USER=deploy
DEPLOY_SSH_KEY_SECRET_NAME=PRODUCTION_DEPLOY_SSH_KEY
