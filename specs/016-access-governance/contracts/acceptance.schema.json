{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradsync.local/schemas/specification-acceptance.json",
  "title": "GradSync Specification Acceptance",
  "description": "Repository evidence binding discipline decisions and governed exceptions to one normative specification revision. Cross-field identity, expiry, and revision checks are enforced by scripts/check-spec-acceptance.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "specificationPath",
    "normativeRevision",
    "decisions",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "specificationPath": {
      "type": "string",
      "pattern": "^specs/[0-9]{3}-[a-z0-9-]+/spec\\.md$"
    },
    "normativeRevision": {
      "$ref": "#/$defs/revision"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "testing", "development"],
      "properties": {
        "product": {
          "$ref": "#/$defs/decision"
        },
        "testing": {
          "$ref": "#/$defs/decision"
        },
        "development": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableRevision": {
      "oneOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignedReviewer",
        "decision",
        "decidedRevision",
        "decidedAt",
        "rationale"
      ],
      "properties": {
        "assignedReviewer": {
          "$ref": "#/$defs/identity"
        },
        "decision": {
          "enum": ["pending", "accepted", "rejected"]
        },
        "decidedRevision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "decidedAt": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "pending"
              }
            },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "decidedRevision": {
                "type": "null"
              },
              "decidedAt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "decidedRevision": {
                "$ref": "#/$defs/revision"
              },
              "decidedAt": {
                "$ref": "#/$defs/timestamp"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "approver",
        "coveredDisciplines",
        "normativeRevision",
        "releaseScope",
        "reason",
        "approvedAt",
        "expiresAt",
        "revokedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXC-[0-9]{4}-[0-9]{3,}$"
        },
        "owner": {
          "$ref": "#/$defs/identity"
        },
        "approver": {
          "$ref": "#/$defs/identity"
        },
        "coveredDisciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["product", "testing", "development"]
          }
        },
        "normativeRevision": {
          "$ref": "#/$defs/revision"
        },
        "releaseScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revokedAt": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    }
  }
}

